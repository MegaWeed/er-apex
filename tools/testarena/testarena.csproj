<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildProjectDirectory)\..\..\er-data\test_arena\dotnet</ArtifactsPath>
    <RestorePackagesPath>$(UserProfile)\.nuget\packages</RestorePackagesPath>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="checks\**\*.cs" />
    <ProjectReference Include="..\third_party\SoulsFormatsNEXT\SoulsFormats\SoulsFormats.csproj"
      AdditionalProperties="UseArtifactsOutput=true;ArtifactsPath=$(ArtifactsPath);RestorePackagesPath=$(RestorePackagesPath)" />
  </ItemGroup>
</Project>
